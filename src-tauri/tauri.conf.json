{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra Turntable",
  "mainBinaryName": "lyra",
  "version": "1.0.1",
  "identifier": "com.hoai.turntable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyra Turntable",
        "width": 1040,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Lyra Turntable — a bit-perfect turntable player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
